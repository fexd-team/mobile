[
  {
    "id": "A1",
    "category": "daily",
    "prompt": "用 @fexd/mobile 做一个登录表单，包含用户名、密码、提交按钮",
    "should_trigger": true,
    "deterministic_checks": [
      "import.*Form.*from '@fexd/mobile'",
      "import.*LineInput.*from '@fexd/mobile'",
      "import.*Button.*from '@fexd/mobile'",
      "Form\\.Field",
      "Form\\.useForm"
    ],
    "negative_checks": ["Form\\.Item", "Input(?!.*Line)", "\\[form\\].*=.*Form\\.useForm"],
    "rubric_focus": ["correctness", "best_practice"]
  },
  {
    "id": "A2",
    "category": "daily",
    "prompt": "帮我加一个确认删除的弹窗",
    "should_trigger": true,
    "deterministic_checks": ["import.*showDialog.*from '@fexd/mobile'", "showDialog\\(", "actions.*content"],
    "negative_checks": ["Dialog\\.confirm", "visible.*useState"],
    "rubric_focus": ["correctness", "best_practice"]
  },
  {
    "id": "A3",
