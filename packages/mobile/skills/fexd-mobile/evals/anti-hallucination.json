[
  {
    "id": "H1",
    "category": "anti-hallucination",
    "prompt": "@fexd/mobile 的 Button 支持 danger prop 吗？",
    "should_trigger": true,
    "deterministic_checks": ["type.*danger|type=\"danger\"", "不支持|没有|不存在|不是.*prop"],
    "negative_checks": ["danger.*prop.*支持", "<Button danger", "Button.*danger=.*true"],
    "rubric_focus": ["correctness", "interaction_quality"],
    "expected_answer": "Button 没有 danger prop，danger 是 type 属性的一个值，应使用 type=\"danger\""
  },
  {
